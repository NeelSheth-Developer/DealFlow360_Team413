# =============================================================================
# Team_413 — Backend Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the real values:
#     cp .env.example .env
# `.env` is git-ignored. NEVER commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# One of: development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=5000

# Public base URL of this API (used to build links inside emails)
API_URL=http://localhost:5000

# Public URL of the frontend (used for CORS + email links)
CLIENT_URL=http://localhost:5173

# Comma-separated list of origins allowed by CORS.
# Use "*" to allow every origin (development only).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Neon (Serverless Postgres)  ->  https://console.neon.tech
# -----------------------------------------------------------------------------
# Dashboard > your project > Connect > copy the connection string.
# Use the pooled connection (the host contains "-pooler").
# `sslmode=require` is mandatory for Neon.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# Upstash Redis (REST)  ->  https://console.upstash.com
# -----------------------------------------------------------------------------
# Console > your database > REST API tab. Copy the two values below.
# This is the HTTP API, not the redis:// protocol — no connection pooling needed,
# and it works from serverless/edge runtimes.
UPSTASH_REDIS_REST_URL=https://your-db-name-12345.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Prefix applied to every key this service writes (keeps envs from colliding)
REDIS_PREFIX=team413:dev

# Default cache TTL in seconds (3600 = 1 hour)
REDIS_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Resend (Transactional email)  ->  https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. teamvector.space is the main domain and must be verified at
# https://resend.com/domains (publish the DKIM + SPF records it gives you)
# before Resend will deliver from it.
# noreply@ is unmonitored — no Reply-To is set, so replies bounce.
# For testing before the domain is verified, use: onboarding@resend.dev
EMAIL_FROM="DealFlow360 <noreply@teamvector.space>"

# -----------------------------------------------------------------------------
# Cloudinary (Media storage)  ->  https://console.cloudinary.com  > Dashboard
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Folder every upload from this service is nested under
CLOUDINARY_FOLDER=team413/dev

# Max upload size accepted by the API, in megabytes
MAX_UPLOAD_MB=10

# -----------------------------------------------------------------------------
# Auth / Security
# -----------------------------------------------------------------------------
# Generate strong values with:  openssl rand -hex 32
JWT_SECRET=replace_me_with_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# Rate limiting (fixed window, backed by Upstash)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
