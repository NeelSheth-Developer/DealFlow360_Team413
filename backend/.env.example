# =============================================================================
# Team_413 — Backend Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the real values:
#     cp .env.example .env
# `.env` is git-ignored. NEVER commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# One of: development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=5050

# Public base URL of this API (used to build links inside emails)
API_URL=http://localhost:5050

# Public URL of the frontend (used for CORS + email links)
CLIENT_URL=http://localhost:5173

# Comma-separated list of origins allowed by CORS.
# Use "*" to allow every origin (development only).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug


# -----------------------------------------------------------------------------
# Neon Postgres  ->  https://console.neon.tech
# -----------------------------------------------------------------------------
# One URL only. The pooled connection string works for both the app and
# drizzle-kit, so there is no separate DIRECT_URL to keep in step.
#
# Copy the "Pooled connection" string from the Neon dashboard. NEVER commit a
# real value here — this file is tracked; the real one lives in .env, which is not.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# Upstash Redis  ->  https://console.upstash.com
# -----------------------------------------------------------------------------
# Both values come from the database's REST API tab. This is the HTTP API, not
# the redis:// protocol — the client is @upstash/redis, which speaks HTTPS, so a
# redis:// URL will not work here.
#
# Used for one-time codes and rate limiting.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Prefix applied to every key this service writes (keeps envs from colliding)
REDIS_PREFIX=team413:dev

# Default cache TTL in seconds (3600 = 1 hour)
REDIS_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Resend (Transactional email)  ->  https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. The domain must be verified at https://resend.com/domains.
# For testing without a verified domain use: onboarding@resend.dev
EMAIL_FROM="DealFlow360 <noreply@teamvector.space>"


# -----------------------------------------------------------------------------
# Auth / Security
# -----------------------------------------------------------------------------
# Generate with:  openssl rand -hex 32
JWT_SECRET=replace_me_with_openssl_rand_hex_32

# Access token life, seconds. Keep SHORT — a JWT cannot be revoked, so any token
# already issued keeps working for this long after logout or deactivation. 900 = 15 min.
ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token life, seconds. Stored server-side and revocable, so it can be long.
# 604800 = 7 days. Same for internal users and customers.
REFRESH_TOKEN_TTL_SECONDS=604800

# -----------------------------------------------------------------------------
# One-time passwords (stored in Upstash Redis, hashed, auto-expiring)
# -----------------------------------------------------------------------------
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# -----------------------------------------------------------------------------
# Rate limiting (fixed window, backed by Upstash)
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# Tighter bucket for credential endpoints (login, signup, OTP, password reset).
# Keyed on IP + email, and fails CLOSED if Redis is unreachable.
AUTH_RATE_LIMIT_MAX=10


# Returns the OTP in the API response so the flow can be tested without a working
# email provider. Requires NODE_ENV != production as well. MUST stay false in production.
EXPOSE_DEV_OTP=false

# =============================================================================
# Cloudinary — generated quotation and invoice PDFs
# =============================================================================
# Optional as a group. With none of the three set, the PDF endpoints stream the
# file back directly instead of returning a hosted URL, so the API stays fully
# usable without a Cloudinary account.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dealflow360


# -----------------------------------------------------------------------------
# Resend's free tier has a daily ceiling. When it runs out, OTP mail stops and
# signups block — so a second route is worth having.
#
# GMAIL_APP_PASSWORD is a 16-character App Password, NOT the account password.
# Generate one at  https://myaccount.google.com/apppasswords  (needs 2-Step
# Verification enabled first). Paste it with the spaces removed.
#
# EMAIL_TRANSPORT:
#   auto    Resend first, Gmail if Resend fails      (default)
#   resend  Resend only, no fallback
#   gmail   Gmail only — use this while Resend's quota is spent

# -----------------------------------------------------------------------------
# Brevo  ->  the fallback sender, used when Resend refuses a message
# -----------------------------------------------------------------------------
# Resend's free tier has a daily ceiling; hitting it stops OTP mail and blocks
# signups. Brevo posts over HTTPS like Resend, so unlike an SMTP relay it still
# works on hosts that block outbound SMTP.
#
#   1. Sign up at https://app.brevo.com
#   2. Verify a sender or authenticate a domain (Senders, Domains & Dedicated IPs)
#   3. Create a key at  https://app.brevo.com/settings/keys/api
#
# EMAIL_TRANSPORT:
#   auto    Resend, then Brevo   (default)
#   resend  Resend only
#   brevo   Brevo only - use this while Resend's quota is spent
BREVO_API_KEY=
EMAIL_TRANSPORT=auto
