# =============================================================================
# Team_413 — Backend Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the real values:
#     cp .env.example .env
# `.env` is git-ignored. NEVER commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# One of: development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=5000

# Public base URL of this API (used to build links inside emails)
API_URL=http://localhost:5000

# Public URL of the frontend (used for CORS + email links)
CLIENT_URL=http://localhost:5173

# Comma-separated list of origins allowed by CORS.
# Use "*" to allow every origin (development only).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug


# Direct (non-pooled) connection — used by drizzle-kit for migrations.
# Same string as above with "-pooler" removed from the host.
DIRECT_URL=postgresql://neondb_owner:npg_j9fO0uriZnah@ep-noisy-river-b3vx31t2-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# -----------------------------------------------------------------------------
# Redis  ->  https://console.upstash.com  (or a local/self-hosted Redis)
# -----------------------------------------------------------------------------
# Local:    redis://localhost:6379
# Upstash:  rediss://default:PASSWORD@xxxx.upstash.io:6379   (note: rediss = TLS)
REDIS_URL=redis://localhost:6379

# Prefix applied to every key this service writes (keeps envs from colliding)
REDIS_PREFIX=team413:dev

# Default cache TTL in seconds (3600 = 1 hour)
REDIS_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Resend (Transactional email)  ->  https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. The domain must be verified at https://resend.com/domains.
# For testing without a verified domain use: onboarding@resend.dev
EMAIL_FROM="DealFlow360 <noreply@teamvector.space>"

# Where user replies are delivered (optional)
EMAIL_REPLY_TO=support@example.com

# -----------------------------------------------------------------------------
# Cloudinary (Media storage)  ->  https://console.cloudinary.com  > Dashboard
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Folder every upload from this service is nested under
CLOUDINARY_FOLDER=team413/dev

# Max upload size accepted by the API, in megabytes
MAX_UPLOAD_MB=10

# -----------------------------------------------------------------------------
# Auth / Security
# -----------------------------------------------------------------------------
# Generate strong values with:  openssl rand -hex 32
JWT_SECRET=replace_me_with_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# Rate limiting (fixed window, backed by Redis)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
