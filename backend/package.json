{
  "name": "team413-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Team_413 backend \u2014 Express + TypeScript, Neon Postgres, Upstash Redis, Resend, Cloudinary",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "verify:risk": "tsx src/scripts/verify-risk.ts",
    "verify:engines": "tsx src/scripts/verify-engines.ts",
    "e2e": "tsx src/scripts/e2e.ts",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@upstash/redis": "^1.35.7",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.20.2",
    "pino": "^9.13.1",
    "pino-http": "^10.5.0",
    "resend": "^6.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.9.2",
    "@types/pdfkit": "^0.17.6",
    "drizzle-kit": "^0.31.6",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
